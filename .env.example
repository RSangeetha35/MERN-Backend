# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use MONGO_URL (the app reads this variable name)
MONGO_URL=mongodb://127.0.0.1:27017/hms_db
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/hms_db?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS — frontend origin(s) ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000
# Production example:
# CLIENT_URL=https://your-frontend.onrender.com,http://localhost:3000

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@hms.hospital
